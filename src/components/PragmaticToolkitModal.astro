---
/**
 * PragmaticToolkitModal
 * 3x3 interactive modal showcasing Oleksandr's pragmatic toolkit principles.
 * Uses SVG icons directly from public/My Pragmatic Toolkit/
 * Built with semantic HTML5 (<dialog>), CSS :target, and strictly 0kb client JS.
 */

// Load all SVGs directly from the folder using Vite's static asset glob
const svgMap = import.meta.glob<string>(
  '../../public/My Pragmatic Toolkit/*.svg',
  {
    query: '?raw',
    import: 'default',
    eager: true,
  }
);

function getSvg(filename: string): string {
  const key = `../../public/My Pragmatic Toolkit/${filename}`;
  const content = svgMap[key];
  if (!content) {
    throw new Error(`SVG icon not found: ${key}`);
  }
  return content;
}

const items = [
  {
    file: "Ship Measure Iterate.svg",
    title: "Ship, Measure, Iterate",
    desc: "Perfect is the enemy of shipped. I prefer releasing fast, gathering live analytics, and iterating over endless polishing.",
  },
  {
    file: "Architecture Before Pixels.svg",
    title: "Architecture Before Pixels",
    desc: "Products start in documentation. OOUX mapping builds a solid foundation, solving complex backend logic before UI design.",
  },
  {
    file: "Modular Design Process.svg",
    title: "Modular Design Process",
    desc: "Textbook processes fail in reality. I adapt to the chaos. If deep user interviews are blocked for months, we skip, build, and test live.",
  },
  {
    file: "Rapid AI Prototyping.svg",
    title: "Rapid AI Prototyping",
    desc: "In 2026, live prototypes are the ultimate communication tool. It’s the cheapest, fastest way to align stakeholders or kill a bad idea early.",
  },
  {
    file: "Cognitive Minimalism.svg",
    title: "Cognitive Minimalism",
    desc: "Like specialty coffee, UI copy is best served black. I write pragmatic, minimalist text to cut the noise and reduce cognitive friction.",
  },
  {
    file: "Obsessive Data Coverage.svg",
    title: "Obsessive Data Coverage",
    desc: "The best time to integrate analytics is day one. Every tracked input directly improves the quality of our CRO and product decisions.",
  },
  {
    file: "Semantic Design Systems.svg",
    title: "Semantic Design Systems",
    desc: "A strong token foundation scales infinitely. I build systems readable by LLMs and developers, ensuring strict EU a11y compliance by default.",
  },
  {
    file: "The Quantum Physics of Time.svg",
    title: "The Quantum Physics of Time",
    desc: "A task takes exactly as much time as you give it. I focus on strict scoping and pragmatic delivery to prevent endless design loops.",
  },
  {
    file: "Embracing Legacy Systems.svg",
    title: "Embracing Legacy Systems",
    desc: "You can’t always rewrite the backend. Whether facing SLDS v1 or ancient .NET, I find elegant solutions within strict constraints.",
  },
].map((item) => ({
  ...item,
  svgContent: getSvg(item.file),
}));
---

<dialog id="details" class="toolkit-modal" aria-label="My Pragmatic Toolkit">
  <a href="#pragmatic-toolkit" class="toolkit-backdrop" aria-label="Close modal" tabindex="-1"></a>
  <div class="toolkit-dialog" role="document">
    <a href="#pragmatic-toolkit" class="toolkit-close" aria-label="Close modal">
      <svg class="toolkit-close-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </a>

    <div class="toolkit-grid">
      {items.map((item) => (
        <article class="toolkit-item">
          <div class="toolkit-icon" set:html={item.svgContent} />
          <h3 class="toolkit-item-title text-heading">{item.title}</h3>
          <p class="toolkit-item-desc text-body-sm text-secondary">{item.desc}</p>
        </article>
      ))}
    </div>
  </div>
</dialog>

<style>
  .toolkit-modal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: var(--space-4);
    border: none;
    background: transparent;
    z-index: var(--z-modal);
    box-sizing: border-box;
  }

  .toolkit-modal:target {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toolkit-backdrop {
    position: fixed;
    inset: 0;
    background-color: var(--color-backdrop);
    cursor: default;
    text-decoration: none;
  }

  .toolkit-dialog {
    position: relative;
    width: 100%;
    max-width: var(--modal-width-lg);
    max-height: calc(100vh - var(--space-8));
    overflow-y: auto;
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-modal);
    z-index: 1;
    overscroll-behavior: contain;
    padding: var(--space-8);
    box-sizing: border-box;
  }

  .toolkit-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-8);
    height: var(--space-8);
    color: var(--color-text-primary);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-default), background-color var(--duration-fast) var(--ease-default);
    z-index: 10;
  }

  .toolkit-close:hover,
  .toolkit-close:focus-visible {
    opacity: 0.75;
    background-color: var(--color-surface-subtle);
  }

  .toolkit-close-icon {
    width: 20px;
    height: 20px;
  }

  .toolkit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .toolkit-item {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .toolkit-item:nth-child(3n) {
    border-right: none;
  }

  .toolkit-item:nth-child(n + 7) {
    border-bottom: none;
  }

  .toolkit-icon {
    width: var(--toolkit-icon-size);
    height: var(--toolkit-icon-size);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .toolkit-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .toolkit-item-title {
    margin-bottom: var(--container-gap-xs);
    color: var(--color-text-primary);
  }

  .toolkit-item-desc {
    color: var(--color-text-secondary);
  }

  @media (max-width: 860px) {
    .toolkit-modal {
      padding: var(--space-2);
    }

    .toolkit-dialog {
      max-height: calc(100vh - var(--space-4));
      padding: var(--space-8) var(--space-4) var(--space-6);
    }

    .toolkit-grid {
      grid-template-columns: 1fr;
    }

    .toolkit-item {
      padding: var(--space-6) var(--space-2);
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .toolkit-item:last-child {
      border-bottom: none;
    }
  }
</style>
