<dialog id="details" class="toolkit-modal" aria-label="My Pragmatic Toolkit">
  <a href="#pragmatic-toolkit" class="toolkit-backdrop" aria-label="Close modal" tabindex="-1"></a>
  <div class="toolkit-dialog" role="document">
    <a href="#pragmatic-toolkit" class="toolkit-close" aria-label="Close modal">
      <svg class="toolkit-close-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </a>

    <div class="toolkit-grid">
      {items.map((item) => (
        <article class="toolkit-item">
          <div class="toolkit-icon">
            <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d={item.path} fill="currentColor" />
            </svg>
          </div>
          <h3 class="toolkit-item-title text-heading">{item.title}</h3>
          <p class="toolkit-item-desc text-body-sm text-secondary">{item.desc}</p>
        </article>
      ))}
    </div>
  </div>
</dialog>

<style>
  .toolkit-modal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: var(--space-4);
    border: none;
    background: transparent;
    z-index: var(--z-modal);
    box-sizing: border-box;
  }

  .toolkit-modal:target {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toolkit-backdrop {
    position: fixed;
    inset: 0;
    background-color: var(--color-backdrop);
    cursor: default;
    text-decoration: none;
  }

  .toolkit-dialog {
    position: relative;
    width: 100%;
    max-width: var(--modal-width-lg);
    max-height: calc(100vh - var(--space-8));
    overflow-y: auto;
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-modal);
    z-index: 1;
    overscroll-behavior: contain;
  }

  .toolkit-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-8);
    height: var(--space-8);
    color: var(--color-text-primary);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-default), background-color var(--duration-fast) var(--ease-default);
    z-index: 10;
  }

  .toolkit-close:hover,
  .toolkit-close:focus-visible {
    opacity: 0.75;
    background-color: var(--color-surface-subtle);
  }

  .toolkit-close-icon {
    width: 20px;
    height: 20px;
  }

  .toolkit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .toolkit-item {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .toolkit-item:nth-child(3n) {
    border-right: none;
  }

  .toolkit-item:nth-child(n + 7) {
    border-bottom: none;
  }

  .toolkit-icon {
    width: var(--toolkit-icon-size);
    height: var(--toolkit-icon-size);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .toolkit-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .toolkit-item-title {
    margin-bottom: var(--container-gap-xs);
    color: var(--color-text-primary);
  }

  .toolkit-item-desc {
    color: var(--color-text-secondary);
  }

  @media (max-width: 860px) {
    .toolkit-modal {
      padding: var(--space-2);
    }

    .toolkit-dialog {
      max-height: calc(100vh - var(--space-4));
    }

    .toolkit-grid {
      grid-template-columns: 1fr;
    }

    .toolkit-item {
      padding: var(--space-6) var(--space-4);
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .toolkit-item:last-child {
      border-bottom: none;
    }
  }
</style>
