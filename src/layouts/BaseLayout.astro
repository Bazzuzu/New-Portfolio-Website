---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Oleksandr Konovalov — Lead Product Designer",
  description = "Lead Product Designer in TravelTech. Mapping complex logic. Optimizing conversion.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/icon-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        function resolveTheme() {
          const hour = new Date().getHours();
          const isNight = hour >= 19 || hour < 7;
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (prefersDark || isNight) {
            document.documentElement.dataset.theme = 'dark';
          } else {
            delete document.documentElement.dataset.theme;
          }
        }
        resolveTheme();
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', resolveTheme);
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
